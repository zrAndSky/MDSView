{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MDSView",
        "width": 1120,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["msi"],
    "fileAssociations": [],
    "windows": {
      "wix": {
        "template": "windows/main.wxs",
        "bannerPath": "windows/assets/wix-banner.bmp",
        "dialogImagePath": "windows/assets/wix-dialog.bmp",
        "language": {
          "en-US": {
            "localePath": "windows/locales/en-US.wxl"
          }
        },
        "fragmentPaths": [
          "windows/file-associations.wxs",
          "windows/file-association-ui.wxs"
        ],
        "componentRefs": []
      }
    }
  }
